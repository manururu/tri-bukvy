# {{ ansible_managed }}
# Стек wg-easy (WireGuard + веб-интерфейс) и Caddy (обратный прокси, Let's Encrypt).
# Перезапускать стек только через `docker compose up/down`, не через start/stop.
name: wg-easy

services:
  wg-easy:
    image: {{ wg_easy_image }}
    container_name: wg-easy
    environment:
      # Внутри контейнера UI слушает 80 — Caddy проксирует на wg-easy:80.
      PORT: "{{ wg_easy_ui_port }}"
    volumes:
      - etc_wireguard:/etc/wireguard
      - /lib/modules:/lib/modules:ro
    ports:
      - "{{ wg_easy_wireguard_port }}:51820/udp"
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv4.conf.all.src_valid_mark=1
      - net.ipv6.conf.all.disable_ipv6=0
      - net.ipv6.conf.all.forwarding=1
      - net.ipv6.conf.default.forwarding=1
    restart: unless-stopped

  caddy:
    image: {{ wg_easy_caddy_image }}
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    # Сервисы в одной сети по умолчанию — Caddyfile обращается к wg-easy по имени сервиса.

volumes:
  etc_wireguard:
  caddy-data:
  caddy-config:
